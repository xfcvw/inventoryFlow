APP_NAME=InventoryFlow
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY
APP_DEBUG=false
APP_URL=https://YOUR_CLOUD_RUN_URL
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
DB_PORT=5432
DB_DATABASE=inventoryflow
DB_USERNAME=inventoryflow_app
DB_PASSWORD=STORE_IN_SECRET_MANAGER
DB_SSLMODE=disable
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
